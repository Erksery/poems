{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layout": {
      "default": "default",
      "type": "string",
      "enum": [
        "default",
        "with-artwork"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "slug",
    "collections"
  ]
}